---
// Animated thumbnail for a research area. One canvas per area; the drawing depends on `kind`:
//   graph    – rotating communities of a graph, with messages passing along the edges
//   flow     – particles flowing from noise to a target shape (flow matching)
//   molecule – a rotating ball-and-stick molecule
//   proof    – a proof tree being assembled from axioms up to ∎
//   search   – a reasoning search exploring paths and committing to one
//   lean     – a Lean proof typed line by line, each tactic reshaping the goal's syntax tree
//   agent    – an LLM agent calling tools and models (database, code, network, molecule) and returning an answer
// Animations pause when off-screen and show a single still frame with prefers-reduced-motion.
interface Props {
  kind: 'graph' | 'flow' | 'molecule' | 'proof' | 'search' | 'lean' | 'agent';
  seed?: string;
}
const { kind, seed = kind } = Astro.props;
---

<div class="area-anim">
  <canvas data-kind={kind} data-seed={seed} aria-hidden="true"></canvas>
</div>

<script>
  type Ctx = CanvasRenderingContext2D;
  type Palette = { accent: string; gold: string; green: string; text: string; muted: string; line: string; bg: string };
  type Scene = { draw: (ctx: Ctx, w: number, h: number, t: number) => void; still?: number }; // `still`: time shown with reduced motion

  const css = (name: string, fallback: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;
  const palette = (): Palette => ({
    accent: css('--accent', '#b23a2e'),
    gold: css('--gold', '#d9a913'),
    green: css('--accent-2', '#5d7a31'),
    text: css('--text', '#1a1d29'),
    muted: css('--muted', '#5f6472'),
    line: css('--line', '#e6dfd1'),
    bg: css('--bg-elev', '#fffdf8'),
  });
  let P = palette();

  function rng(seed: string) {
    let h = 2166136261;
    for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
    return () => {
      h ^= h << 13;
      h ^= h >>> 17;
      h ^= h << 5;
      return ((h >>> 0) % 100000) / 100000;
    };
  }
  const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const clamp = (x: number, a = 0, b = 1) => Math.max(a, Math.min(b, x));
  const dot = (ctx: Ctx, x: number, y: number, r: number) => {
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  };

  /* ---------- graph: communities that rotate and drift, with message passing ---------- */
  function graphScene(rand: () => number): Scene {
    // Three communities (like entity clusters in a knowledge graph). Each one slowly rotates around its own
    // centre while the centres drift, so the whole network keeps moving; edges between communities are dashed.
    const C = [
      { cx: 0.2, cy: 0.42, r: 0.3, n: 7, spin: 0.22 },
      { cx: 0.5, cy: 0.6, r: 0.26, n: 6, spin: -0.18 },
      { cx: 0.8, cy: 0.4, r: 0.3, n: 7, spin: 0.15 },
    ].map((c) => ({ ...c, ph: rand() * Math.PI * 2 }));
    type N = { c: number; ang: number; rad: number; ph: number; hub: boolean; flash: number };
    const nodes: N[] = [];
    C.forEach((c, ci) => {
      nodes.push({ c: ci, ang: 0, rad: 0, ph: rand() * 6, hub: true, flash: -10 });
      for (let i = 0; i < c.n; i++)
        nodes.push({
          c: ci,
          ang: (i / c.n) * Math.PI * 2 + rand() * 0.5,
          rad: 0.55 + rand() * 0.45,
          ph: rand() * 6,
          hub: false,
          flash: -10,
        });
    });
    const edges: { a: number; b: number; inter: boolean }[] = [];
    const has = (a: number, b: number) => edges.some((e) => (e.a === a && e.b === b) || (e.a === b && e.b === a));
    C.forEach((_, ci) => {
      const ids = nodes.map((n, i) => (n.c === ci ? i : -1)).filter((i) => i >= 0);
      const hub = ids[0];
      const ring = ids.slice(1).sort((x, y) => nodes[x].ang - nodes[y].ang);
      ring.forEach((id, k) => {
        if (k % 2 === 0 || rand() < 0.4) edges.push({ a: hub, b: id, inter: false }); // spokes
        if (rand() < 0.75) edges.push({ a: id, b: ring[(k + 1) % ring.length], inter: false }); // rim
      });
    });
    for (let k = 0; k < 5; k++) {
      const c1 = k % 2 === 0 ? 0 : 1;
      const c2 = c1 + 1;
      const pick = (ci: number) => {
        const ids = nodes.map((n, i) => (n.c === ci && !n.hub ? i : -1)).filter((i) => i >= 0);
        return ids[Math.floor(rand() * ids.length)];
      };
      const a = pick(c1);
      const b = pick(c2);
      if (!has(a, b)) edges.push({ a, b, inter: true });
    }
    const nbrs = nodes.map((_, i) => edges.flatMap((e) => (e.a === i ? [e.b] : e.b === i ? [e.a] : [])));
    let msgs: { from: number; to: number; start: number; hops: number }[] = [];
    let nextSpawn = 0;
    const pos = (i: number, t: number, w: number, h: number) => {
      const n = nodes[i];
      const c = C[n.c];
      const cx = (c.cx + Math.sin(t * 0.21 + c.ph) * 0.035) * w;
      const cy = (c.cy + Math.cos(t * 0.17 + c.ph) * 0.07) * h;
      if (n.hub) return [cx + Math.sin(t * 0.6 + n.ph) * 2, cy + Math.cos(t * 0.5 + n.ph) * 2];
      const R = c.r * Math.min(h, w * 0.42) * (n.rad + Math.sin(t * 0.7 + n.ph) * 0.12); // breathing; fits narrow cards
      const ang = n.ang + t * c.spin;
      return [cx + Math.cos(ang) * R * 1.15, cy + Math.sin(ang) * R];
    };
    return {
      draw(ctx, w, h, t) {
        if (t > nextSpawn) {
          const from = Math.floor(rand() * nodes.length);
          if (nbrs[from].length) msgs.push({ from, to: nbrs[from][Math.floor(rand() * nbrs[from].length)], start: t, hops: 0 });
          nextSpawn = t + 0.9;
        }
        const P_ = nodes.map((_, i) => pos(i, t, w, h));
        for (const e of edges) {
          const [x1, y1] = P_[e.a];
          const [x2, y2] = P_[e.b];
          ctx.lineWidth = e.inter ? 1.1 : 1.3;
          ctx.strokeStyle = e.inter ? P.muted : P.accent;
          ctx.globalAlpha = e.inter ? 0.45 : 0.32;
          ctx.setLineDash(e.inter ? [4, 4] : []);
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.stroke();
        }
        ctx.setLineDash([]);
        const next: typeof msgs = [];
        for (const m of msgs) {
          const k = (t - m.start) / 1.6;
          if (k >= 1) {
            nodes[m.to].flash = t;
            if (m.hops < 2 && rand() < 0.55 && nbrs[m.to].length)
              next.push({ from: m.to, to: nbrs[m.to][Math.floor(rand() * nbrs[m.to].length)], start: t, hops: m.hops + 1 });
            continue;
          }
          next.push(m);
          const [x1, y1] = P_[m.from];
          const [x2, y2] = P_[m.to];
          const e = ease(k);
          ctx.globalAlpha = 0.95;
          ctx.fillStyle = P.gold;
          dot(ctx, x1 + (x2 - x1) * e, y1 + (y2 - y1) * e, 3);
        }
        msgs = next.slice(-30);
        nodes.forEach((n, i) => {
          const [x, y] = P_[i];
          const f = clamp(1 - (t - n.flash) / 1.4);
          if (f > 0) {
            ctx.globalAlpha = 0.25 * f;
            ctx.fillStyle = P.gold;
            dot(ctx, x, y, 7 + 10 * f);
          }
          ctx.globalAlpha = 1;
          if (n.hub) {
            ctx.fillStyle = P.bg;
            dot(ctx, x, y, 7.5);
            ctx.lineWidth = 2;
            ctx.strokeStyle = f > 0.3 ? P.gold : P.accent;
            ctx.beginPath();
            ctx.arc(x, y, 7.5, 0, Math.PI * 2);
            ctx.stroke();
            ctx.fillStyle = f > 0.3 ? P.gold : P.accent;
            dot(ctx, x, y, 3.2);
          } else {
            ctx.fillStyle = f > 0.3 ? P.gold : P.accent;
            dot(ctx, x, y, 4);
          }
        });
        ctx.globalAlpha = 1;
      },
    };
  }

  /* ---------- flow: noise → shape ---------- */
  function flowScene(rand: () => number): Scene {
    const M = 170;
    const gauss = () => Math.sqrt(-2 * Math.log(rand() + 1e-9)) * Math.cos(2 * Math.PI * rand());
    const shapes = [
      (u: number) => [Math.cos(u * 2 * Math.PI) * 0.3, Math.sin(u * 2 * Math.PI) * 0.3], // ring
      (u: number) => {
        // two moons
        const a = (u < 0.5 ? u * 2 : (u - 0.5) * 2) * Math.PI;
        return u < 0.5 ? [Math.cos(a) * 0.28 - 0.12, -Math.sin(a) * 0.28 + 0.07] : [Math.cos(a) * 0.28 + 0.12, Math.sin(a) * 0.28 - 0.07];
      },
      (u: number) => {
        // spiral
        const a = u * 3.2 * Math.PI;
        const r = 0.05 + u * 0.3;
        return [Math.cos(a) * r, Math.sin(a) * r];
      },
    ];
    const CYCLE = 6.5;
    let parts: { z: [number, number]; x: [number, number]; bend: number }[] = [];
    let cycle = -1;
    const make = (c: number) => {
      const shape = shapes[c % shapes.length];
      parts = Array.from({ length: M }, (_, i) => {
        const [sx, sy] = shape(i / M);
        return {
          z: [gauss() * 0.12, gauss() * 0.12] as [number, number],
          x: [sx + gauss() * 0.012, sy + gauss() * 0.012] as [number, number],
          bend: (rand() - 0.5) * 0.25,
        };
      });
    };
    return {
      draw(ctx, w, h, t) {
        const c = Math.floor(t / CYCLE);
        if (c !== cycle) {
          cycle = c;
          make(c);
        }
        const local = (t % CYCLE) / CYCLE;
        const k = ease(clamp((local - 0.08) / 0.62));
        const fade = local > 0.88 ? 1 - (local - 0.88) / 0.12 : local < 0.06 ? local / 0.06 : 1;
        const S = Math.min(w, h * 1.7);
        const L = (p: [number, number], s: number) => [w * 0.24 + s * w * 0.5 + p[0] * S * 0.62, h * 0.5 + p[1] * S * 0.62];
        const at = (q: (typeof parts)[number], s: number) => {
          const px = q.z[0] * (1 - s) + q.x[0] * s;
          const py = q.z[1] * (1 - s) + q.x[1] * s + Math.sin(Math.PI * s) * q.bend;
          return L([px, py], s);
        };
        ctx.lineWidth = 1;
        for (const q of parts) {
          const [x0, y0] = at(q, Math.max(0, k - 0.12));
          const [x1, y1] = at(q, k);
          ctx.globalAlpha = 0.35 * fade;
          ctx.strokeStyle = P.accent;
          ctx.beginPath();
          ctx.moveTo(x0, y0);
          ctx.lineTo(x1, y1);
          ctx.stroke();
          ctx.globalAlpha = 0.95 * fade;
          ctx.fillStyle = k > 0.97 ? P.gold : P.accent;
          dot(ctx, x1, y1, 2.5);
        }
        ctx.globalAlpha = 1;
      },
    };
  }

  /* ---------- molecule: rotating ball-and-stick ---------- */
  function moleculeScene(): Scene {
    type Atom = { p: [number, number, number]; el: 'C' | 'O' | 'N' | 'H' };
    const atoms: Atom[] = [];
    const bonds: [number, number, number][] = []; // a, b, order
    const ring = (cx: number, start: number) => {
      const ids: number[] = [];
      for (let i = 0; i < 6; i++) {
        const a = (i / 6) * Math.PI * 2 + Math.PI / 6;
        atoms.push({ p: [cx + Math.cos(a) * 1.4, Math.sin(a) * 1.4, 0], el: 'C' });
        ids.push(start + i);
      }
      return ids;
    };
    const r1 = ring(-1.21, 0); // naphthalene-like fused rings
    const r2 = ring(1.21, 6);
    for (let i = 0; i < 6; i++) bonds.push([r1[i], r1[(i + 1) % 6], i % 2 ? 2 : 1]);
    for (let i = 0; i < 6; i++) bonds.push([r2[i], r2[(i + 1) % 6], i % 2 ? 1 : 2]);
    const add = (from: number, el: Atom['el'], len: number, order = 1, z = 0) => {
      const [x, y] = atoms[from].p;
      const cx = x < 0 ? -1.21 : 1.21;
      const d = Math.hypot(x - cx, y) || 1;
      atoms.push({ p: [x + ((x - cx) / d) * len, y + (y / d) * len, z], el });
      bonds.push([from, atoms.length - 1, order]);
      return atoms.length - 1;
    };
    // substituents
    const o = add(r1[2], 'O', 1.3, 1);
    atoms.push({ p: [atoms[o].p[0] - 0.6, atoms[o].p[1] + 0.8, 0.3], el: 'H' });
    bonds.push([o, atoms.length - 1, 1]);
    const n = add(r2[5], 'N', 1.35, 1);
    atoms.push({ p: [atoms[n].p[0] + 0.9, atoms[n].p[1] - 0.5, 0.4], el: 'H' });
    bonds.push([n, atoms.length - 1, 1]);
    atoms.push({ p: [atoms[n].p[0] + 0.3, atoms[n].p[1] - 0.9, -0.6], el: 'H' });
    bonds.push([n, atoms.length - 1, 1]);
    add(r1[4], 'O', 1.25, 2);
    // (r1[0]/r2[2] and r1[5]/r2[3] are the shared atoms of the fused rings)
    [r1[1], r1[3], r2[0], r2[1], r2[4]].forEach((a) => add(a, 'H', 1.0, 1, 0));

    const radius = { C: 0.42, O: 0.42, N: 0.42, H: 0.24 };
    return {
      draw(ctx, w, h, t) {
        const ay = t * 0.45;
        const ax = 0.5 + Math.sin(t * 0.3) * 0.35;
        const S = Math.min(w / 11, h / 7.6);
        const proj = atoms.map(({ p: [x, y, z] }) => {
          const x1 = x * Math.cos(ay) + z * Math.sin(ay);
          const z1 = -x * Math.sin(ay) + z * Math.cos(ay);
          const y1 = y * Math.cos(ax) - z1 * Math.sin(ax);
          const z2 = y * Math.sin(ax) + z1 * Math.cos(ax);
          const s = 14 / (14 + z2);
          return { x: w / 2 + x1 * S * s, y: h / 2 + y1 * S * s, z: z2, s };
        });
        const color = (el: Atom['el']) => (el === 'O' ? P.accent : el === 'N' ? P.gold : el === 'H' ? P.muted : P.text);
        // bonds behind atoms, sorted far → near
        const order = bonds.map((b, i) => ({ i, z: (proj[b[0]].z + proj[b[1]].z) / 2 })).sort((a, b) => b.z - a.z);
        ctx.lineCap = 'round';
        for (const { i } of order) {
          const [a, b, k] = bonds[i];
          const A = proj[a];
          const B = proj[b];
          ctx.strokeStyle = P.muted;
          ctx.globalAlpha = 0.6 + 0.08 * (1 - (A.z + B.z) / 4);
          ctx.lineWidth = 2.2 * A.s;
          if (k === 2) {
            const dx = B.y - A.y;
            const dy = A.x - B.x;
            const L = Math.hypot(dx, dy) || 1;
            for (const sgn of [-1, 1]) {
              ctx.beginPath();
              ctx.moveTo(A.x + (dx / L) * 2.4 * sgn, A.y + (dy / L) * 2.4 * sgn);
              ctx.lineTo(B.x + (dx / L) * 2.4 * sgn, B.y + (dy / L) * 2.4 * sgn);
              ctx.stroke();
            }
          } else {
            ctx.beginPath();
            ctx.moveTo(A.x, A.y);
            ctx.lineTo(B.x, B.y);
            ctx.stroke();
          }
        }
        const ids = atoms.map((_, i) => i).sort((a, b) => proj[b].z - proj[a].z);
        for (const i of ids) {
          const q = proj[i];
          const r = radius[atoms[i].el] * S * 0.62 * q.s;
          ctx.globalAlpha = 1;
          ctx.fillStyle = color(atoms[i].el);
          dot(ctx, q.x, q.y, r);
          ctx.globalAlpha = 0.35;
          ctx.fillStyle = P.bg;
          dot(ctx, q.x - r * 0.3, q.y - r * 0.3, r * 0.35); // highlight
        }
        ctx.globalAlpha = 1;
      },
    };
  }

  /* ---------- proof: tree assembled from axioms to ∎ ---------- */
  function proofScene(rand: () => number): Scene {
    const SYMS = ['∀x', '∃y', 'p→q', 'A⊢B', 'λx', '¬p', 'x=y', 'n+1', '∑', '⊤'];
    type Node = { x: number; y: number; kids: number[]; depth: number; label: string };
    let nodes: Node[] = [];
    let cycle = -1;
    const CYCLE = 7;
    const build = () => {
      nodes = [];
      const leaves = 5 + Math.floor(rand() * 3);
      let level = Array.from({ length: leaves }, (_, i) => {
        nodes.push({ x: (i + 0.5) / leaves, y: 0.86, kids: [], depth: 0, label: SYMS[Math.floor(rand() * SYMS.length)] });
        return nodes.length - 1;
      });
      let d = 1;
      while (level.length > 1) {
        const next: number[] = [];
        for (let i = 0; i < level.length; ) {
          const take = level.length - i >= 2 && rand() < 0.75 ? 2 : 1;
          const kids = level.slice(i, i + take);
          i += take;
          const x = kids.reduce((s, k) => s + nodes[k].x, 0) / kids.length;
          nodes.push({ x, y: 0, kids, depth: d, label: '' });
          next.push(nodes.length - 1);
        }
        level = next;
        d++;
      }
      const maxD = d - 1;
      nodes.forEach((n) => (n.y = 0.86 - (n.depth / Math.max(1, maxD)) * 0.7));
    };
    return {
      draw(ctx, w, h, t) {
        const c = Math.floor(t / CYCLE);
        if (c !== cycle) {
          cycle = c;
          build();
        }
        const local = t % CYCLE;
        const maxD = Math.max(...nodes.map((n) => n.depth));
        const fade = local > CYCLE - 0.8 ? (CYCLE - local) / 0.8 : 1;
        const shown = (n: Node) => clamp((local - 0.3 - n.depth * 0.9) / 0.6);
        const X = (x: number) => w * 0.08 + x * w * 0.84;
        ctx.lineWidth = 1.4;
        ctx.font = `${Math.round(Math.min(15, h / 11))}px 'EB Garamond', serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (const n of nodes) {
          const s = shown(n);
          if (s <= 0) continue;
          for (const k of n.kids) {
            const kid = nodes[k];
            // inference line: from child up to parent, drawn progressively
            ctx.globalAlpha = 0.5 * fade;
            ctx.strokeStyle = P.accent;
            ctx.beginPath();
            ctx.moveTo(X(kid.x), kid.y * h - 9);
            ctx.lineTo(X(kid.x) + (X(n.x) - X(kid.x)) * s, kid.y * h - 9 + (n.y * h + 9 - (kid.y * h - 9)) * s);
            ctx.stroke();
          }
        }
        for (const n of nodes) {
          const s = shown(n);
          if (s <= 0) continue;
          const isRoot = n.depth === maxD;
          ctx.globalAlpha = s * fade;
          if (n.depth === 0) {
            ctx.fillStyle = P.text;
            ctx.fillText(n.label, X(n.x), n.y * h);
          } else if (isRoot) {
            ctx.fillStyle = P.gold;
            dot(ctx, X(n.x), n.y * h, 11 * s);
            ctx.fillStyle = P.bg;
            ctx.fillText('∎', X(n.x), n.y * h + 1);
          } else {
            // rule bar, as in natural deduction
            ctx.strokeStyle = P.text;
            ctx.beginPath();
            ctx.moveTo(X(n.x) - 16, n.y * h);
            ctx.lineTo(X(n.x) + 16, n.y * h);
            ctx.stroke();
            ctx.fillStyle = P.accent;
            dot(ctx, X(n.x), n.y * h, 2.4);
          }
        }
        ctx.globalAlpha = 1;
      },
    };
  }

  /* ---------- search: exploring reasoning paths ---------- */
  function searchScene(rand: () => number): Scene {
    const LAYERS = 6;
    let layers: number[][] = []; // y positions per layer
    let path: number[] = [];
    let cycle = -1;
    const CYCLE = 7.5;
    const build = () => {
      layers = Array.from({ length: LAYERS }, (_, l) => {
        const n = l === 0 || l === LAYERS - 1 ? 1 : 3 + Math.floor(rand() * 2);
        return Array.from({ length: n }, (_, i) => (n === 1 ? 0.5 : 0.18 + (i / (n - 1)) * 0.64 + (rand() - 0.5) * 0.06));
      });
      path = layers.map((ys) => Math.floor(rand() * ys.length));
    };
    return {
      draw(ctx, w, h, t) {
        const c = Math.floor(t / CYCLE);
        if (c !== cycle) {
          cycle = c;
          build();
        }
        const local = t % CYCLE;
        const fade = local > CYCLE - 0.8 ? (CYCLE - local) / 0.8 : 1;
        const X = (l: number) => w * 0.09 + (l / (LAYERS - 1)) * w * 0.82;
        const step = 0.95;
        ctx.lineWidth = 1.2;
        for (let l = 0; l < LAYERS - 1; l++) {
          const tl = local - 0.3 - l * step; // time since this layer started expanding
          if (tl <= 0) continue;
          const from = path[l];
          layers[l + 1].forEach((y2, j) => {
            const chosen = j === path[l + 1];
            const grow = clamp(tl / 0.45);
            const x1 = X(l);
            const y1 = layers[l][from] * h;
            const x2 = X(l) + (X(l + 1) - X(l)) * grow;
            const yy = y1 + (y2 * h - y1) * grow;
            // explored edges fade after the choice; the chosen one turns solid
            const decided = tl > 0.65;
            ctx.strokeStyle = chosen && decided ? P.accent : P.muted;
            ctx.globalAlpha = (chosen && decided ? 0.95 : decided ? 0.12 : 0.4) * fade;
            ctx.lineWidth = chosen && decided ? 2.2 : 1.1;
            ctx.setLineDash(chosen && decided ? [] : [3, 4]);
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, yy);
            ctx.stroke();
          });
        }
        ctx.setLineDash([]);
        layers.forEach((ys, l) => {
          ys.forEach((y, i) => {
            const reached = l === 0 || local - 0.3 - (l - 1) * step > 0.45;
            if (!reached) return;
            const onPath = i === path[l] && (l === 0 || local - 0.3 - (l - 1) * step > 0.65);
            const last = l === LAYERS - 1 && onPath;
            ctx.globalAlpha = (onPath ? 1 : 0.35) * fade;
            ctx.fillStyle = last ? P.gold : onPath ? P.accent : P.muted;
            dot(ctx, X(l), y * h, last ? 8 : onPath ? 5 : 3.5);
          });
        });
        ctx.globalAlpha = 1;
      },
    };
  }

  /* ---------- agent: an LLM agent calling tools and models in turn, then returning an answer ---------- */
  function agentScene(rand: () => number): Scene {
    type Tool = { x: number; y: number; icon: 'db' | 'code' | 'net' | 'mol' };
    const TOOLS: Tool[] = [
      { x: 0.17, y: 0.3, icon: 'db' },
      { x: 0.17, y: 0.72, icon: 'code' },
      { x: 0.83, y: 0.3, icon: 'net' },
      { x: 0.83, y: 0.72, icon: 'mol' },
    ];
    const CYCLE = 9;
    const STEP = 1.5; // one tool call: think, send, work, return
    const START = 0.4;
    let cycle = -1;
    let order: number[] = [];
    const build = () => {
      order = [0, 1, 2, 3].sort(() => rand() - 0.5);
    };
    const drawTool = (ctx: Ctx, tool: Tool, cx: number, cy: number, s: number, on: number) => {
      ctx.strokeStyle = on > 0 ? P.accent : P.text;
      ctx.fillStyle = on > 0 ? P.accent : P.text;
      ctx.lineWidth = 1.4;
      if (on > 0) {
        ctx.save();
        ctx.globalAlpha *= 0.15 * on;
        ctx.fillStyle = P.gold;
        dot(ctx, cx, cy, s * 1.45);
        ctx.restore();
      }
      if (tool.icon === 'db') {
        // database cylinder
        const rw = s * 0.75;
        const rh = s * 0.25;
        ctx.beginPath();
        ctx.ellipse(cx, cy - s * 0.55, rw, rh, 0, 0, Math.PI * 2);
        ctx.stroke();
        for (const dy of [0, s * 0.55]) {
          ctx.beginPath();
          ctx.ellipse(cx, cy + dy, rw, rh, 0, 0, Math.PI);
          ctx.stroke();
        }
        ctx.beginPath();
        ctx.moveTo(cx - rw, cy - s * 0.55);
        ctx.lineTo(cx - rw, cy + s * 0.55);
        ctx.moveTo(cx + rw, cy - s * 0.55);
        ctx.lineTo(cx + rw, cy + s * 0.55);
        ctx.stroke();
      } else if (tool.icon === 'code') {
        // editor window with </>
        ctx.strokeRect(cx - s, cy - s * 0.75, s * 2, s * 1.5);
        ctx.beginPath();
        ctx.moveTo(cx - s, cy - s * 0.4);
        ctx.lineTo(cx + s, cy - s * 0.4);
        ctx.stroke();
        ctx.font = `${Math.round(s * 0.85)}px ui-monospace, SFMono-Regular, Menlo, monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('</>', cx, cy + s * 0.2);
      } else if (tool.icon === 'net') {
        // small neural network: 3 → 2 → 1
        const cols = [3, 2, 1].map((n, c) =>
          Array.from({ length: n }, (_, i) => [cx + (c - 1) * s * 0.85, cy + (i - (n - 1) / 2) * s * 0.6] as const),
        );
        ctx.lineWidth = 0.8;
        ctx.globalAlpha *= 0.6;
        for (let c = 0; c < 2; c++)
          for (const a of cols[c])
            for (const b of cols[c + 1]) {
              ctx.beginPath();
              ctx.moveTo(a[0], a[1]);
              ctx.lineTo(b[0], b[1]);
              ctx.stroke();
            }
        ctx.globalAlpha /= 0.6;
        for (const col of cols) for (const [x, y] of col) dot(ctx, x, y, s * 0.14);
      } else {
        // molecule: hexagonal ring with a side chain
        const r = s * 0.6;
        ctx.beginPath();
        for (let i = 0; i <= 6; i++) {
          const a = Math.PI / 6 + (i * Math.PI) / 3;
          const x = cx - s * 0.2 + r * Math.cos(a);
          const y = cy + r * Math.sin(a);
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.moveTo(cx - s * 0.2 + r * Math.cos(-Math.PI / 6), cy + r * Math.sin(-Math.PI / 6));
        ctx.lineTo(cx + s * 0.9, cy - s * 0.65);
        ctx.stroke();
        dot(ctx, cx + s * 0.9, cy - s * 0.65, s * 0.16);
      }
    };
    return {
      still: 7.4,
      draw(ctx, w, h, t) {
        const c = Math.floor(t / CYCLE);
        if (c !== cycle) {
          cycle = c;
          build();
        }
        const local = t % CYCLE;
        const fade = local > CYCLE - 0.8 ? (CYCLE - local) / 0.8 : 1;
        const s = Math.max(9, Math.min(h * 0.11, w * 0.06, 18));
        const ax = w * 0.5;
        const ay = h * 0.48;
        const X = (x: number) => w * 0.5 + (x - 0.5) * Math.min(w, h * 2.6);
        const done = START + order.length * STEP;

        // links between the agent and its tools; the active one brightens
        TOOLS.forEach((tool, ti) => {
          const i = order.indexOf(ti);
          const st = local - START - i * STEP;
          const active = st > 0.35 && st < 1.4;
          ctx.globalAlpha = (active ? 0.55 : 0.18) * fade;
          ctx.strokeStyle = active ? P.accent : P.muted;
          ctx.lineWidth = active ? 1.4 : 1;
          ctx.setLineDash(active ? [] : [3, 4]);
          ctx.beginPath();
          ctx.moveTo(ax, ay);
          ctx.lineTo(X(tool.x), tool.y * h);
          ctx.stroke();
        });
        ctx.setLineDash([]);

        // packets: a call goes out, the result comes back
        order.forEach((ti, i) => {
          const st = local - START - i * STEP;
          if (st < 0.35 || st > 1.4) return;
          const tool = TOOLS[ti];
          const out = st < 0.75;
          const k = ease(clamp(out ? (st - 0.35) / 0.4 : (st - 1.0) / 0.4));
          if (!out && st < 1.0) return; // tool is working
          const [x0, y0, x1, y1] = out ? [ax, ay, X(tool.x), tool.y * h] : [X(tool.x), tool.y * h, ax, ay];
          ctx.globalAlpha = fade;
          ctx.fillStyle = out ? P.accent : P.gold;
          dot(ctx, x0 + (x1 - x0) * k, y0 + (y1 - y0) * k, 3.5);
        });

        // tools
        TOOLS.forEach((tool, ti) => {
          const st = local - START - order.indexOf(ti) * STEP;
          const on = st > 0.7 && st < 1.15 ? Math.sin(((st - 0.7) / 0.45) * Math.PI) : 0;
          const used = st > 1.15;
          ctx.globalAlpha = (used || on > 0 ? 0.95 : 0.55) * fade;
          drawTool(ctx, tool, X(tool.x), tool.y * h, s, on);
        });

        // the agent: a small robot head with an antenna
        const busy = local > START && local < done;
        const hw = s * 1.35;
        const hh = s * 1.05;
        ctx.globalAlpha = 0.14 * fade;
        ctx.fillStyle = P.accent;
        dot(ctx, ax, ay, s * 2.1 * (busy ? 1 + 0.06 * Math.sin(local * 5) : 1));
        ctx.globalAlpha = fade;
        ctx.strokeStyle = P.accent;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(ax, ay - hh);
        ctx.lineTo(ax, ay - hh - s * 0.5);
        ctx.stroke();
        ctx.fillStyle = P.gold;
        dot(ctx, ax, ay - hh - s * 0.55, s * 0.2);
        ctx.fillStyle = P.accent;
        ctx.beginPath();
        ctx.roundRect(ax - hw, ay - hh, hw * 2, hh * 2, s * 0.4);
        ctx.fill();
        // eyes blink now and then; they glance towards the tool being called
        const cur = order[Math.floor((local - START) / STEP)];
        const look = busy && cur !== undefined ? Math.sign(TOOLS[cur].x - 0.5) * s * 0.15 : 0;
        const blink = (local % 3.1) < 0.12 ? 0.25 : 1;
        ctx.fillStyle = P.bg;
        for (const ex of [-0.45, 0.45]) {
          ctx.beginPath();
          ctx.ellipse(ax + ex * hw + look, ay - hh * 0.1, s * 0.18, s * 0.22 * blink, 0, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.fillRect(ax - hw * 0.35, ay + hh * 0.45, hw * 0.7, s * 0.12);

        // thinking dots before each call
        order.forEach((_, i) => {
          const st = local - START - i * STEP;
          if (st < 0 || st > 0.35) return;
          for (let d = 0; d < 3; d++) {
            ctx.globalAlpha = (0.3 + 0.7 * clamp(Math.sin((st / 0.35) * Math.PI * 2 - d))) * fade;
            ctx.fillStyle = P.muted;
            dot(ctx, ax + hw + s * 0.5 + d * s * 0.45, ay - hh - s * 0.3, s * 0.12);
          }
        });

        // the answer, once every tool has been used
        const a = clamp((local - done) / 0.5);
        if (a > 0) {
          const ry = Math.min(h - s * 1.1, ay + hh + s * 1.6);
          ctx.globalAlpha = a * fade;
          ctx.fillStyle = P.gold;
          dot(ctx, ax, ry, s * 0.75 * ease(a));
          ctx.strokeStyle = P.bg;
          ctx.lineWidth = 1.8;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(ax - s * 0.32, ry);
          ctx.lineTo(ax - s * 0.08, ry + s * 0.25);
          ctx.lineTo(ax + s * 0.35, ry - s * 0.25);
          ctx.stroke();
          ctx.lineCap = 'butt';
        }
        ctx.globalAlpha = 1;
      },
    };
  }

  /* ---------- lean: a proof typed line by line, each tactic reshaping the goal's syntax tree ---------- */
  function leanScene(): Scene {
    const CODE = [
      'example (x y : ℝ) (h : x^2 ≠ y^2) :',
      '    (x + y)^2 + (x - y)^2',
      '      = 2 * (x^4 - y^4) / (x^2 - y^2) := by',
      '  have h1 : x^2 - y^2 ≠ 0 := sub_ne_zero.mpr h',
      '  rw [eq_div_iff h1]',
      '  ring_nf',
    ];
    const KEYWORDS = new Set(['example', 'have', 'by', 'rw', 'ring_nf']);
    const LEMMAS = new Set(['sub_ne_zero.mpr', 'eq_div_iff']);
    const MONO = "'JetBrains Mono', ui-monospace, monospace";

    // Goal ASTs. Nodes keep their id across goals, so a tactic moves, adds, and removes nodes between trees.
    type T = { id: string; label: string; kids: T[] };
    const n = (id: string, label: string, ...kids: T[]): T => ({ id, label, kids });
    const pow = (id: string, base: string, e: string) => n(id, '^', n(id + 'b', base), n(id + 'e', e));
    const lhs = n(
      'L', '+',
      n('s1', '^', n('a', '+', n('ax', 'x'), n('ay', 'y')), n('s1e', '2')),
      n('s2', '^', n('b', '−', n('bx', 'x'), n('by', 'y')), n('s2e', '2')),
    );
    const num = (p: string) => n(p + 'N', '*', n(p + 'c', '2'), n(p + 'd', '−', pow(p + 'x4', 'x', '4'), pow(p + 'y4', 'y', '4')));
    const den = n('D', '−', pow('dx', 'x', '2'), pow('dy', 'y', '2'));
    const goals = [
      n('eq', '=', lhs, n('R', '/', num(''), den)), // the statement
      n('eq', '=', n('M', '*', lhs, den), num('')), // after rw [eq_div_iff h1]
      n('eq', '=', num('nf'), num('')), // after ring_nf: both sides in the same normal form
    ];
    const subtree = (t: T): string[] => [t.id, ...t.kids.flatMap(subtree)];
    const denIds = new Set(subtree(den));
    const LEVELS = 5; // deepest goal tree, so the tree keeps its scale between goals

    type Pos = { x: number; y: number; depth: number; label: string; op: boolean };
    const layout = (root: T, x0: number, x1: number, y0: number, dy: number) => {
      const nodes = new Map<string, Pos>();
      const edges: string[] = [];
      const count = (t: T): number => (t.kids.length ? t.kids.reduce((s, k) => s + count(k), 0) : 1);
      const total = count(root);
      let leaf = 0;
      const place = (t: T, depth: number): number => {
        const x = t.kids.length
          ? t.kids.reduce((s, k) => (edges.push(`${t.id}>${k.id}`), s + place(k, depth + 1)), 0) / t.kids.length
          : x0 + ((leaf++ + 0.5) / total) * (x1 - x0);
        nodes.set(t.id, { x, y: y0 + depth * dy, depth, label: t.label, op: t.kids.length > 0 });
        return x;
      };
      place(root, 0);
      return { nodes, edges };
    };
    type Layout = ReturnType<typeof layout>;
    // Nodes in both trees move; the others fade out (only in A) or in (only in B).
    const blend = (A: Layout, B: Layout, k: number) => {
      const nodes = new Map<string, Pos & { a: number }>();
      for (const [id, p] of A.nodes) {
        const q = B.nodes.get(id);
        nodes.set(id, q ? { ...q, x: p.x + (q.x - p.x) * k, y: p.y + (q.y - p.y) * k, a: 1 } : { ...p, a: 1 - k });
      }
      for (const [id, q] of B.nodes) if (!A.nodes.has(id)) nodes.set(id, { ...q, a: k });
      const inB = new Set(B.edges);
      const edges = [
        ...A.edges.map((e) => ({ e, a: inB.has(e) ? 1 : 1 - k })),
        ...B.edges.filter((e) => !A.edges.includes(e)).map((e) => ({ e, a: k })),
      ];
      return { nodes, edges };
    };

    // Timeline: each line is typed, then its tactic acts on the tree.
    const CPS = 38; // characters typed per second
    const typed: { start: number; end: number }[] = [];
    let clock = 0.3;
    const type = (i: number) => {
      typed[i] = { start: clock, end: clock + CODE[i].length / CPS };
      clock = typed[i].end;
    };
    type(0);
    type(1);
    type(2);
    const parse = clock + 0.2;
    clock = parse + 1.6;
    type(3);
    const mark = clock + 0.15; // have h1: the denominator is known to be nonzero
    clock = mark + 1.0;
    type(4);
    const rw = clock + 0.15; // the denominator moves to the left-hand side
    clock = rw + 1.8;
    type(5);
    const ring = clock + 0.15; // the left-hand side is normalised into the right-hand side
    const same = ring + 1.3;
    const collapse = same + 0.8;
    const CYCLE = collapse + 4.2;
    const SPEED = 0.6; // playback rate of the whole timeline above
    const activeUntil = [typed[0].end, typed[1].end, typed[2].end, mark + 0.6, rw + 1.4, same + 0.7];

    const backOut = (x: number) => 1 + 2.70158 * Math.pow(x - 1, 3) + 1.70158 * Math.pow(x - 1, 2);
    // Draw in the base colour, crossfading to gold as `m` goes from 0 to 1.
    const tone = (ctx: Ctx, a: number, m: number, base: string, draw: (color: string) => void) => {
      if (m < 1) {
        ctx.globalAlpha = a * (1 - m);
        draw(base);
      }
      if (m > 0) {
        ctx.globalAlpha = a * m;
        draw(P.gold);
      }
    };

    return {
      still: (parse + 1.4) / SPEED,
      draw(ctx, w, h, t) {
        const local = (t * SPEED) % CYCLE;
        const fade = local > CYCLE - 0.8 ? (CYCLE - local) / 0.8 : 1;

        /* code box */
        ctx.font = `100px ${MONO}`;
        const widest = Math.max(...CODE.map((l) => ctx.measureText(l).width)) / 100;
        const pad = 12;
        const fs = Math.min(13.5, (w * 0.46 - 2 * pad) / widest, (h * 0.82 - 2 * pad) / (1.55 * CODE.length));
        const lh = fs * 1.55;
        const boxW = widest * fs + 2 * pad;
        const boxH = lh * CODE.length + 2 * pad;
        const bx = Math.max(10, w * 0.03);
        const by = (h - boxH) / 2;
        ctx.fillStyle = P.line;
        ctx.globalAlpha = 0.3 * fade;
        ctx.beginPath();
        ctx.roundRect(bx, by, boxW, boxH, 8);
        ctx.fill();
        ctx.globalAlpha = fade;
        ctx.strokeStyle = P.line;
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.font = `${fs}px ${MONO}`;
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        CODE.forEach((line, i) => {
          const { start, end } = typed[i];
          if (local < start) return;
          const y = by + pad + lh * (i + 0.5);
          if (local < activeUntil[i]) {
            ctx.globalAlpha = 0.1 * fade;
            ctx.fillStyle = P.accent;
            ctx.fillRect(bx + 1, y - lh / 2, boxW - 2, lh);
          }
          const shown = line.slice(0, Math.floor(((local - start) / (end - start)) * line.length));
          let x = bx + pad;
          ctx.globalAlpha = fade;
          for (const tok of shown.match(/[A-Za-z_][\w.']*|\s+|./gu) ?? []) {
            ctx.fillStyle = KEYWORDS.has(tok) ? P.accent : LEMMAS.has(tok) ? P.green : P.text;
            ctx.fillText(tok, x, y);
            x += ctx.measureText(tok).width;
          }
          if (local < end) {
            ctx.fillStyle = P.accent;
            ctx.fillRect(x + 1, y - fs * 0.55, 1.5, fs * 1.1);
          }
        });

        /* goal tree */
        const tx0 = bx + boxW + Math.max(16, w * 0.04);
        const tx1 = w - Math.max(10, w * 0.03);
        const dy = (h * 0.74) / LEVELS;
        const L = goals.map((g) => layout(g, tx0, tx1, h * 0.13, dy));
        const r = clamp(Math.min(dy * 0.3, ((tx1 - tx0) / 15) * 0.42), 5, 11);
        const cx = (tx0 + tx1) / 2;
        const cy = h * 0.42;
        if (local < parse) return;
        const tree =
          local < rw
            ? blend(L[0], L[0], 0)
            : local < ring
              ? blend(L[0], L[1], ease(clamp((local - rw) / 1.4)))
              : blend(L[1], L[2], ease(clamp((local - ring) / 1.3)));
        if (local < rw) for (const p of tree.nodes.values()) p.a = clamp((local - parse - p.depth * 0.2) / 0.35);
        const gone = ease(clamp((local - collapse) / 0.7));
        for (const p of tree.nodes.values()) {
          p.x += (cx - p.x) * gone;
          p.y += (cy - p.y) * gone;
          p.a *= (1 - gone) * fade;
        }
        const denMark = clamp((local - mark) / 0.5) * (1 - clamp((local - rw - 0.9) / 0.5));
        const allMark = clamp((local - same) / 0.3);
        const markOf = (id: string) => Math.max(denIds.has(id) ? denMark : 0, allMark);

        ctx.lineWidth = 1.3;
        for (const { e, a } of tree.edges) {
          const [pid, kid] = e.split('>');
          const p = tree.nodes.get(pid)!;
          const q = tree.nodes.get(kid)!;
          tone(ctx, 0.5 * a * Math.min(p.a, q.a), Math.min(markOf(pid), markOf(kid)), P.accent, (c) => {
            ctx.strokeStyle = c;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.stroke();
          });
        }
        ctx.font = `${Math.round(r * 1.25)}px ${MONO}`;
        ctx.textAlign = 'center';
        for (const [id, p] of tree.nodes) {
          if (p.a <= 0.01) continue;
          const m = markOf(id);
          ctx.globalAlpha = p.a;
          ctx.fillStyle = P.bg;
          dot(ctx, p.x, p.y, p.op ? r : r * 0.8);
          if (p.op)
            tone(ctx, p.a, m, P.accent, (c) => {
              ctx.strokeStyle = c;
              ctx.beginPath();
              ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
              ctx.stroke();
            });
          tone(ctx, p.a, m, P.text, (c) => {
            ctx.fillStyle = c;
            ctx.fillText(p.label, p.x, p.y + 1);
          });
        }
        const D = tree.nodes.get('D');
        if (D && denMark > 0) {
          ctx.globalAlpha = denMark * D.a;
          ctx.fillStyle = P.gold;
          ctx.textAlign = 'left';
          ctx.fillText('≠ 0', D.x + r + 4, D.y - r);
        }

        /* goal closed */
        const grow = clamp((local - collapse - 0.45) / 0.5);
        if (grow > 0) {
          const R = Math.min(h * 0.17, (tx1 - tx0) * 0.12) * backOut(grow);
          ctx.globalAlpha = fade;
          ctx.fillStyle = P.gold;
          dot(ctx, cx, cy, R);
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = R * 0.16;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.beginPath();
          ctx.moveTo(cx - R * 0.42, cy + R * 0.02);
          ctx.lineTo(cx - R * 0.12, cy + R * 0.32);
          ctx.lineTo(cx + R * 0.45, cy - R * 0.3);
          ctx.stroke();
          ctx.lineCap = 'butt';
          const size = Math.round(Math.min(24, h / 8));
          ctx.globalAlpha = clamp((local - collapse - 0.9) / 0.5) * fade;
          ctx.fillStyle = P.text;
          ctx.font = `${size}px 'EB Garamond', serif`;
          ctx.textAlign = 'center';
          ctx.fillText('Problem solved!', cx, cy + Math.min(h * 0.17, (tx1 - tx0) * 0.12) + size * 1.1);
        }
        ctx.globalAlpha = 1;
      },
    };
  }

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const kind = canvas.dataset.kind!;
    const rand = rng(canvas.dataset.seed ?? kind);
    const scene =
      kind === 'flow'
        ? flowScene(rand)
        : kind === 'molecule'
          ? moleculeScene()
          : kind === 'proof'
            ? proofScene(rand)
            : kind === 'search'
              ? searchScene(rand)
              : kind === 'lean'
                ? leanScene()
                : kind === 'agent'
                  ? agentScene(rand)
                  : graphScene(rand);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0;
    let h = 0;
    let running = false;
    let raf = 0;
    const t0 = performance.now() - rand() * 3000;
    const frame = (stillAt?: number) => {
      ctx.clearRect(0, 0, w, h);
      scene.draw(ctx, w, h, stillAt ?? (performance.now() - t0) / 1000);
    };
    const loop = () => {
      frame();
      if (running) raf = requestAnimationFrame(loop);
    };
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (!running) frame(reduce ? (scene.still ?? 4.5) : undefined);
    };
    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !reduce && !running) {
        running = true;
        raf = requestAnimationFrame(loop);
      } else if (!e.isIntersecting) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }).observe(canvas);
    const recolor = () => {
      P = palette();
      if (!running) frame(reduce ? (scene.still ?? 4.5) : undefined);
    };
    window.addEventListener('themechange', recolor);
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);
  }

  document.querySelectorAll<HTMLCanvasElement>('.area-anim canvas').forEach(init);
</script>

