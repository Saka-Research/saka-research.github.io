---
// Dot-plot comparison of methods per benchmark, with tabs to switch benchmarks.
// Dots slide in when a tab is shown; the highlighted method gets a colored, labeled dot.
export type Row = { m: string; v: number };
export type Bench = {
  id: string;
  label: string;
  metric: string;
  better: 'higher' | 'lower';
  note?: string;
  decimals?: number;
  domain?: [number, number]; // fixed axis range, e.g. starting at 0
  rows: Row[];
};

interface Props {
  benches: Bench[];
  highlight: string; // method name to emphasize
  caption?: string;
}

const { benches, highlight, caption } = Astro.props;
---

<figure class="res" data-reveal>
  <div class="tabs pills" role="tablist" aria-label="Benchmark">
    {
      benches.map((b, i) => (
        <button type="button" class="pill" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-bench={b.id}>
          {b.label}
        </button>
      ))
    }
  </div>

  {
    benches.map((b, i) => {
      const vals = b.rows.map((r) => r.v);
      const span = Math.max(...vals) - Math.min(...vals);
      const pad = span * 0.12;
      const decimals = b.decimals ?? (b.better === 'lower' ? 3 : 2);
      // snap the domain to round numbers so the end labels are exact
      const step = [0.01, 0.05, 0.1, 0.5, 1, 2, 5, 10].find((st) => st >= span / 4) ?? 10;
      const lo = b.domain ? b.domain[0] : Math.floor((Math.min(...vals) - pad) / step) * step;
      const hi = b.domain ? b.domain[1] : Math.ceil((Math.max(...vals) + pad) / step) * step;
      const axisDec = (b.domain ? hi > 1 : step >= 1) ? 0 : 2; // decimals for the axis labels
      const pct = (v: number) => ((v - lo) / (hi - lo)) * 100;
      const best = b.better === 'higher' ? Math.max(...vals) : Math.min(...vals);
      return (
        <div class="panel" data-panel={b.id} hidden={i !== 0}>
          <div class="metric">
            {b.metric} · <span>{b.better} is better {b.better === 'higher' ? '→' : '←'}</span>
          </div>
          <ul class="rows">
            {b.rows.map((r, j) => (
              <li class:list={['row', { me: r.m === highlight }]} style={`--x:${pct(r.v)}%; --j:${j}`}>
                <span class="name">{r.m}</span>
                <span class="track">
                  <span class="rule" />
                  <span class="dot" tabindex="0" aria-label={`${r.m}: ${r.v.toFixed(decimals)}`}>
                    <span class="val">{r.v.toFixed(decimals)}</span>
                  </span>
                </span>
                {(r.m === highlight || r.v === best) && <span class="lab">{r.v.toFixed(decimals)}</span>}
              </li>
            ))}
          </ul>
          <div class="axis">
            <span>{lo.toFixed(axisDec)}</span>
            <span>{((lo + hi) / 2).toFixed(axisDec)}</span>
            <span>{hi.toFixed(axisDec)}</span>
          </div>
          {b.note && <p class="note">{b.note}</p>}
        </div>
      );
    })
  }
  <figcaption>
    {caption ??
      (benches.every((b) => b.domain && b.domain[0] === 0)
        ? 'Selected baselines; full tables in the paper.'
        : 'Selected baselines; full tables in the paper. The axis does not start at zero.')}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.res').forEach((fig) => {
    const tabs = fig.querySelectorAll<HTMLButtonElement>('[data-bench]');
    const panels = fig.querySelectorAll<HTMLElement>('[data-panel]');

    function show(id: string) {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.bench === id)));
      panels.forEach((p) => {
        const on = p.dataset.panel === id;
        p.hidden = !on;
        p.classList.remove('go');
        if (on) requestAnimationFrame(() => requestAnimationFrame(() => p.classList.add('go')));
      });
    }
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.bench!)));

    new IntersectionObserver(([e], io) => {
      if (e.isIntersecting) {
        io.disconnect();
        show(tabs[0].dataset.bench!);
      }
    }, { threshold: 0.3 }).observe(fig);
  });
</script>

<style>
  .res {
    margin: 32px 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-elev);
  }
  .metric {
    margin: 16px 0 10px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .metric span {
    font-weight: 400;
    color: var(--muted);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 110px 1fr 54px;
    align-items: center;
    gap: 10px;
    height: 32px;
  }
  .name {
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .me .name {
    color: var(--text);
    font-weight: 600;
  }
  .track {
    position: relative;
    height: 100%;
  }
  .rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--line);
  }
  .dot {
    position: absolute;
    top: 50%;
    left: 0;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--muted);
    box-shadow: 0 0 0 2px var(--bg-elev);
    outline: none;
    transition: left 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--j) * 0.06s);
  }
  .dot::before {
    /* larger hit target than the mark */
    content: '';
    position: absolute;
    inset: -10px;
  }
  .me .dot {
    background: var(--chart-1);
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
  }
  .go .dot {
    left: var(--x);
  }
  .val {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .dot:hover .val,
  .dot:focus-visible .val {
    opacity: 1;
  }
  .lab {
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    opacity: 0;
    transition: opacity 0.4s ease 0.8s;
  }
  .go .lab {
    opacity: 1;
  }
  .axis {
    display: flex;
    justify-content: space-between;
    margin: 4px 64px 0 120px;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .note {
    margin: 12px 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  figcaption {
    margin-top: 10px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .row {
      grid-template-columns: 90px 1fr 46px;
    }
    .axis {
      margin: 4px 56px 0 100px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      left: var(--x);
    }
    .lab {
      opacity: 1;
    }
  }
</style>
