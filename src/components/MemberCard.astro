---
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import type { Member } from '../lib/content';

interface Props {
  member: Member;
  delay?: number;
  compact?: boolean; // name + role only (used on research pages)
}
const { member, delay = 0, compact = false } = Astro.props;
const { name, role, affiliation, since, photo, bio, cosupervisors, links } = member.data;

const icons = [
  links.website && { name: 'website', href: links.website, label: 'Website' },
  links.scholar && { name: 'scholar', href: links.scholar, label: 'Google Scholar' },
  links.github && { name: 'github', href: links.github, label: 'GitHub' },
  links.x && { name: 'x', href: links.x, label: 'X' },
  links.linkedin && { name: 'linkedin', href: links.linkedin, label: 'LinkedIn' },
  links.email && { name: 'email', href: `mailto:${links.email}`, label: 'Email' },
].filter(Boolean) as { name: 'website' | 'scholar' | 'github' | 'x' | 'linkedin' | 'email'; href: string; label: string }[];
---

<article class:list={['card', 'hoverable', 'member', { compact }]} id={member.id} data-reveal style={`--reveal-delay:${delay}s`}>
  <Avatar name={name} photo={photo} size={compact ? 56 : 92} />
  <div class="body">
    <h3>{name}</h3>
    <p class="role">{role}</p>
    {!compact && (affiliation || since) && <p class="aff">{[affiliation, since && `since ${since}`].filter(Boolean).join(' · ')}</p>}
    {!compact && <p class="bio">{bio}</p>}
    {
      !compact && cosupervisors.length > 0 && (
        <p class="cosup">
          Co-supervised with: <span>{cosupervisors.join(', ')}</span>
        </p>
      )
    }
  </div>
  {
    !compact && icons.length > 0 && (
      <div class="icons">
        {icons.map((i) => (
          <a href={i.href} aria-label={`${name}: ${i.label}`} title={i.label}>
            <Icon name={i.name} size={16} />
          </a>
        ))}
      </div>
    )
  }
</article>

<style>
  .member {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px 18px 18px;
    height: 100%;
  }
  .member.compact {
    flex-direction: row;
    text-align: left;
    gap: 14px;
    padding: 14px 16px;
  }
  .body {
    position: relative;
    flex: 1;
    margin-top: 14px;
  }
  .compact .body {
    margin-top: 0;
  }
  h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  p {
    margin: 0;
  }
  .role {
    margin-top: 3px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .aff {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .bio {
    margin-top: 10px;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .member:hover .bio {
    -webkit-line-clamp: unset;
  }
  .cosup {
    margin-top: 10px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .cosup span {
    color: var(--text);
  }
  .icons {
    position: relative;
    display: flex;
    gap: 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    width: 100%;
    justify-content: center;
  }
  .icons a {
    color: var(--muted);
    background: none;
  }
  .icons a:hover {
    color: var(--accent);
  }
</style>
