---
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import type { Member } from '../lib/content';

interface Props {
  member: Member;
  delay?: number;
  compact?: boolean; // name + role only (used on research pages)
}
const { member, delay = 0, compact = false } = Astro.props;
const { name, role, affiliation, since, photo, bio, cosupervisors, links, alumni } = member.data;
// Alumni: "DPhil, 2018–2022" instead of the role, and where they are now instead of the affiliation
const roleLine = alumni ? (alumni.period ?? role) : role;
const affLine = alumni
  ? alumni.now && `Now: ${alumni.now}`
  : [affiliation, since && `since ${since}`].filter(Boolean).join(' · ');

const icons = [
  links.website && { name: 'website', href: links.website, label: 'Website' },
  links.scholar && { name: 'scholar', href: links.scholar, label: 'Google Scholar' },
  links.github && { name: 'github', href: links.github, label: 'GitHub' },
  links.x && { name: 'x', href: links.x, label: 'X' },
  links.linkedin && { name: 'linkedin', href: links.linkedin, label: 'LinkedIn' },
  links.email && { name: 'email', href: `mailto:${links.email}`, label: 'Email' },
].filter(Boolean) as { name: 'website' | 'scholar' | 'github' | 'x' | 'linkedin' | 'email'; href: string; label: string }[];
---

<article
  class:list={['card', 'member', { compact, hoverable: compact }]}
  id={member.id}
  data-member-card={compact ? undefined : member.id}
  data-reveal
  style={`--reveal-delay:${delay}s`}
>
  <Avatar name={name} photo={photo} size={compact ? 56 : 92} />
  <div class="body">
    <h3>
      {
        compact ? (
          name
        ) : (
          <button type="button" class="open" data-open-member={member.id} aria-haspopup="dialog">
            {name}
          </button>
        )
      }
    </h3>
    <p class="role">{roleLine}</p>
    {!compact && affLine && <p class="aff">{affLine}</p>}
    {!compact && <p class="bio">{bio}</p>}
    {
      !compact && cosupervisors.length > 0 && (
        <div class="cosup">
          Co-supervised with:
          <ul>
            {cosupervisors.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  {
    !compact && icons.length > 0 && (
      <div class="icons">
        {icons.map((i) => (
          <a href={i.href} aria-label={`${name}: ${i.label}`} title={i.label}>
            <Icon name={i.name} size={16} />
          </a>
        ))}
      </div>
    )
  }
</article>

<style>
  .member {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px 18px 18px;
    height: 100%;
  }
  .member.compact {
    flex-direction: row;
    text-align: left;
    gap: 14px;
    padding: 14px 16px;
  }
  .body {
    position: relative;
    flex: 1;
    margin-top: 14px;
  }
  .compact .body {
    margin-top: 0;
  }
  h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  p {
    margin: 0;
  }
  .role {
    margin-top: 3px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .aff {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .bio {
    margin-top: 10px;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  [data-member-card] {
    cursor: pointer;
  }
  .open {
    font: inherit;
    color: inherit;
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
  }
  .cosup {
    margin-top: 10px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .cosup ul {
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
    color: var(--text);
  }
  .icons {
    position: relative;
    display: flex;
    gap: 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    width: 100%;
    justify-content: center;
  }
  .icons a {
    color: var(--muted);
    background: none;
  }
  .icons a:hover {
    color: var(--accent);
  }
</style>
