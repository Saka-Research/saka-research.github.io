---
// Breadcrumbs + page title + subtitle, used at the top of every inner page.
interface Props {
  title: string;
  subtitle?: string;
  crumbs?: { label: string; href?: string }[]; // without "Home" and the current page
}
const { title, subtitle, crumbs = [] } = Astro.props;
---

<header class="page-header" data-reveal>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    {
      crumbs.map((c) => (
        <>
          <span aria-hidden="true">›</span>
          {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
        </>
      ))
    }
    <span aria-hidden="true">›</span>
    <span aria-current="page">{title}</span>
  </nav>
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <slot />
</header>

<style>
  .page-header {
    padding-top: 40px;
    margin-bottom: 32px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--text);
  }
  h1::before {
    content: '';
    display: block;
    width: 44px;
    height: 4px;
    margin: 18px 0 16px;
    border-radius: 2px;
    background: var(--accent);
  }
  h1 {
    margin: 10px 0 10px;
    font-size: clamp(2.6rem, 6.5vw, 3.8rem);
  }
  .subtitle {
    margin: 0;
    max-width: 40em;
    font-size: 1.1rem;
    color: var(--muted);
  }
</style>
