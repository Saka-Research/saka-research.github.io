---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE, NAV } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.shortName}` : `${SITE.name} | ${SITE.location}`;
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {SITE.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} news`} href="/rss.xml" />
    {Astro.site && <link rel="canonical" href={new URL(path, Astro.site)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${SITE.name} home`}>
          <img src="/media/goldfinch-small.png" alt="" width="68" height="45" class="bird" />
          <span>{SITE.name}</span>
        </a>
        <nav class="main-nav" id="main-nav">
          {
            NAV.map((item) => (
              <a href={item.href} class:list={{ active: isActive(item.href) }}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="tools">
          <a href="/archives/" class="tool" aria-label="News archive" title="News archive"><Icon name="archive" size={20} /></a>
          <a href="/search/" class:list={['tool', { on: isActive('/search') }]} aria-label="Search" title="Search"
            ><Icon name="search" size={20} /></a
          >
          <button class="tool theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <span class="when-light"><Icon name="moon" size={20} /></span>
            <span class="when-dark"><Icon name="sun" size={20} /></span>
          </button>
          <button class="tool menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="main-nav">
            <Icon name="menu" size={20} />
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-links">
          {SITE.footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
        <div class="footer-bottom">
          <span class="muted colophon">
            <img src="/media/goldfinch-small.png" alt="" width="34" height="23" />
            © {new Date().getFullYear()} {SITE.name} · <em>saka</em> is Turkish for goldfinch
          </span>
          <span class="social">
            {
              SITE.social.map((s) => (
                <a href={s.href} aria-label={s.label} title={s.label}>
                  <Icon name={s.kind} size={17} />
                </a>
              ))
            }
            <a href={`mailto:${SITE.email}`} aria-label={`Send an email to ${SITE.name}`} title="Email"
              ><Icon name="email" size={17} /></a
            >
          </span>
        </div>
      </div>
    </footer>

    <script>
      // Reveal [data-reveal] elements as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Light / dark toggle (remembers the choice when storage is available).
      const root = document.documentElement;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme ?? (systemDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        window.dispatchEvent(new Event('themechange'));
      });

      // Mobile menu
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
      menuBtn?.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open');
        menuBtn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 12px;
    top: 12px;
    z-index: 100;
    padding: 6px 12px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    border-bottom: 1.5px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    letter-spacing: 0.01em;
    color: var(--text);
    background: none;
    white-space: nowrap;
  }
  .brand .bird {
    height: 45px;
    width: auto;
    margin: 0 -2px 0 -6px;
    border-radius: 0;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .brand:hover .bird {
    transform: rotate(-4deg) translateY(-1px);
  }
  .main-nav {
    display: flex;
    gap: 26px;
    margin-left: auto;
  }
  .main-nav a {
    color: var(--muted);
    font-size: 1.02rem;
    font-weight: 500;
  }
  .main-nav a:hover,
  .main-nav a.active {
    color: var(--text);
  }
  .main-nav a.active {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 2px;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .tool {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .tool:hover,
  .tool.on {
    color: var(--text);
    background-color: color-mix(in srgb, var(--line) 55%, transparent);
  }
  .when-dark {
    display: none;
  }
  :global(:root[data-theme='dark']) .when-dark {
    display: inline;
  }
  :global(:root[data-theme='dark']) .when-light {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .when-dark {
      display: inline;
    }
    :global(:root:not([data-theme='light'])) .when-light {
      display: none;
    }
  }
  .menu-toggle {
    display: none;
  }
  @media (max-width: 760px) {
    .header-inner {
      justify-content: space-between;
    }
    .menu-toggle {
      display: inline-grid;
    }
    .main-nav {
      display: none;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px 20px 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .main-nav a {
      align-self: flex-start;
      padding: 10px 0 4px;
      margin-bottom: 6px;
      font-size: 1.05rem;
      background-position: 0 100%;
    }
    .main-nav a.active {
      color: var(--text);
    }
    :global(body.menu-open) .main-nav {
      display: flex;
    }
  }
  @media (max-width: 480px) {
    .header-inner {
      gap: 8px;
    }
    .brand {
      font-size: 1.15rem;
    }
    .brand .bird {
      height: 36px;
    }
    .tool {
      width: 34px;
    }
  }
  main {
    min-height: calc(100vh - 200px);
  }
  .site-footer {
    margin-top: 96px;
    padding: 0 0 36px;
    font-size: 0.85rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    padding: 22px 0;
    border-top: 1.5px solid var(--line);
  }
  .footer-links a {
    color: var(--muted);
  }
  .footer-links a:hover {
    color: var(--text);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .colophon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .colophon img {
    border-radius: 0;
    opacity: 0.85;
  }
  .social {
    display: flex;
    gap: 14px;
  }
  .social a {
    color: var(--muted);
    background: none;
  }
  .social a:hover {
    color: var(--accent);
  }
</style>
