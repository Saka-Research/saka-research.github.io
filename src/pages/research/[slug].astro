---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import MemberCard from '../../components/MemberCard.astro';
import PubItem from '../../components/PubItem.astro';
import AreaAnimation from '../../components/AreaAnimation.astro';
import { getResearch, getTeam, getPublications, getMemberNames, type Research } from '../../lib/content';

export async function getStaticPaths() {
  const areas = await getResearch();
  return areas.map((area) => ({ params: { slug: area.id }, props: { area } }));
}

const { area } = Astro.props as { area: Research };
const { Content } = await render(area);
const { current } = await getTeam();
const people = current.filter((m) => m.data.areas.some((r) => r.id === area.id));
const pubs = (await getPublications()).filter((p) => p.data.areas.some((r) => r.id === area.id));
// Papers referenced in the text with ([↓](#pub-<file-name>)) are always listed; the rest is filled up with featured papers.
const refs = new Set([...(area.body ?? '').matchAll(/#pub-([\w-]+)/g)].map((m) => m[1]));
const referenced = pubs.filter((p) => refs.has(p.id));
const others = [...pubs.filter((p) => p.data.featured), ...pubs.filter((p) => !p.data.featured)].filter((p) => !refs.has(p.id));
const selected = [...referenced, ...others.slice(0, Math.max(0, 6 - referenced.length))].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const members = await getMemberNames();
---

<Base title={area.data.title} description={area.data.summary}>
  <section class="container">
    <PageHeader title={area.data.title} subtitle={area.data.summary} crumbs={[{ label: 'Research', href: '/research/' }]} />

    <div class="card intro" data-reveal>
      <div class="banner">
        {area.data.image ? <img src={area.data.image} alt="" /> : <AreaAnimation kind={area.data.bannerAnimation ?? area.data.animation} seed={area.id} />}
      </div>
      <div class="prose"><Content /></div>

      {
        area.data.directions.length > 0 && (
          <>
            <h2>Key Directions</h2>
            <ul class="directions">
              {area.data.directions.map((d) => (
                <li>
                  <strong>{d.name}:</strong> {d.text}
                </li>
              ))}
            </ul>
          </>
        )
      }
      <div class="tags">
        {area.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>

    {
      people.length > 0 && (
        <>
          <div class="section-head" data-reveal>
            <h2>People</h2>
          </div>
          <div class="people">
            {people.map((m, i) => (
              <a href={`/team/#${m.id}`} class="plain">
                <MemberCard member={m} compact delay={i * 0.04} />
              </a>
            ))}
          </div>
        </>
      )
    }

    {
      selected.length > 0 && (
        <>
          <div class="section-head" data-reveal>
            <h2>Selected Publications</h2>
            <a href="/publications/">All publications →</a>
          </div>
          <div class="pubs">
            {selected.map((p, i) => (
              <PubItem pub={p} members={members} compact delay={(i % 2) * 0.06} />
            ))}
          </div>
        </>
      )
    }
  </section>
</Base>

<script>
  // Arrow links in the text, e.g. ([↓](#pub-flock)), scroll to that paper below and briefly light it up in red.
  const flash = (el: HTMLElement) => {
    el.classList.remove('flash');
    void el.offsetWidth; // restart the animation if clicked again
    el.classList.add('flash');
    setTimeout(() => el.classList.remove('flash'), 1800);
  };
  document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="#pub-"]').forEach((a) => {
    const target = document.getElementById(a.hash.slice(1));
    if (!target) return;
    a.classList.add('pub-ref');
    a.title = target.querySelector('h3')?.textContent?.trim() ?? '';
    a.setAttribute('aria-label', `Jump to paper: ${a.title}`);
    a.addEventListener('click', (e) => {
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      history.replaceState(null, '', a.hash);
      setTimeout(() => flash(target), 450);
    });
  });
  if (location.hash.startsWith('#pub-')) {
    const t = document.getElementById(location.hash.slice(1));
    if (t) setTimeout(() => flash(t), 600);
  }
</script>

<style>
  .intro {
    padding: 0 28px 24px;
  }
  .banner {
    height: clamp(180px, 26vw, 300px);
    margin: 0 -28px 8px;
    border-bottom: 1px solid var(--line);
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }
  .intro > :global(*) {
    position: relative;
  }
  .intro h2 {
    margin: 1.6em 0 0.6em;
    font-size: 1.6rem;
  }
  .intro .prose {
    max-width: none;
  }
  .directions {
    padding-left: 1.2em;
    margin: 0;
  }
  .directions li + li {
    margin-top: 6px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 12px;
  }
  .plain {
    background: none;
    color: inherit;
  }
  /* People tiles are single links: fill red on hover, like other link tiles */
  .plain:hover :global(.card) {
    background-color: var(--fill);
    border-color: var(--fill);
    transform: translateY(-2px);
  }
  .plain:hover :global(.card :is(h3, p)) {
    color: var(--on-fill);
  }
  .prose :global(a.pub-ref) {
    display: inline-block;
    padding: 0 1px;
    font-weight: 600;
    text-decoration: none;
    background-image: none;
    transition: transform 0.2s ease;
  }
  .prose :global(a.pub-ref:hover) {
    transform: translateY(2px);
  }
  /* Briefly fill a paper red when it is reached from an arrow link */
  .pubs :global(.pub.flash) {
    animation: pub-flash 1.8s ease;
  }
  .pubs :global(.pub.flash *) {
    animation: pub-flash-text 1.8s ease;
  }
  @keyframes pub-flash {
    0%,
    55% {
      background-color: var(--fill);
      border-color: var(--fill);
    }
  }
  @keyframes pub-flash-text {
    0%,
    55% {
      color: var(--on-fill);
    }
  }
  .pubs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
</style>
