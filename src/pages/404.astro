---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="container narrow">
    <h1>Page not found</h1>
    <p class="muted">This page flew away. Try the <a href="/">home page</a> or <a href="/search/">search</a>.</p>
  </section>
</Base>

<style>
  section {
    padding-top: 80px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 8px;
  }
</style>
