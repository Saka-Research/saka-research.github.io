---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import MemberCard from '../components/MemberCard.astro';
import { SITE } from '../site.config';
import { getTeam } from '../lib/content';

const { current, alumni } = await getTeam();
---

<Base title="Team" description={`Meet the researchers behind ${SITE.name}.`}>
  <section class="container">
    <PageHeader title="Team" subtitle={`Meet the researchers behind ${SITE.name}`} />

    <div class="grid">
      {current.map((m, i) => <MemberCard member={m} delay={(i % 4) * 0.05} />)}
    </div>

    {
      alumni.length > 0 && (
        <>
          <div class="section-head" data-reveal>
            <h2>Alumni — where are they now</h2>
          </div>
          <div class="alumni">
            {alumni.map((m, i) => (
              <div class="alum" data-reveal style={`--reveal-delay:${(i % 4) * 0.04}s`}>
                <h3>{m.data.name}</h3>
                {m.data.alumni!.period && <p class="period">{m.data.alumni!.period}</p>}
                {m.data.alumni!.thesis && <p class="thesis">{m.data.alumni!.thesis}</p>}
                <p class="muted">Now: {m.data.alumni!.now}</p>
                {m.data.alumni!.website && <a href={m.data.alumni!.website}>Website →</a>}
              </div>
            ))}
          </div>
        </>
      )
    }
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    align-items: stretch;
  }
  .alumni {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0 24px;
  }
  .alum {
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }
  .alum h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .alum p {
    margin: 2px 0 4px;
    font-size: 0.88rem;
  }
  .alum .period {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .alum .thesis {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
  }
  .alum a {
    font-size: 0.85rem;
  }
</style>
